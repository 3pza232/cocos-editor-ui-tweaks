{
    "name": "cocos-editor-ui-tweaks",
    "version": "1.0.1",
    "package_version": 2,
    "main": "./src/browser.js",
    "panels": {
        "default": {
            "title": "Editor UI Tweaks",
            "main": "./src/panel/index.js",
            "type": "dockable",
            "size": {
                "width": 480,
                "height": 300
            },
            "min-width": 280
        }
    },
    "contributions": {
        "menu": [
            {
                "path": "i18n:menu.extension",
                "label": "Editor UI Tweaks",
                "message": "open"
            }
        ],
        "messages": {
            "open": { "methods": ["open"] },
            "get-config": { "methods": ["getConfig"] },
            "set-config": { "methods": ["setConfig"] },
            "inject-css": { "methods": ["injectCSS"] },
            "remove-css": { "methods": ["removeCSS"] }
        }
    }
}
